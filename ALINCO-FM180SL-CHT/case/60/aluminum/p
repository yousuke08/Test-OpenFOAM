FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "60/aluminum";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];


internalField   uniform 101325;

boundaryField
{
    base
    {
        type            calculated;
        value           uniform 101325;
    }
    end
    {
        type            calculated;
        value           uniform 101325;
    }
    symm
    {
        type            symmetryPlane;
    }
    aluminum_to_air
    {
        type            calculated;
        value           uniform 101325;
    }
}


