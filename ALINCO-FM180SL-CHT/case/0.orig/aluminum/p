FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/aluminum";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Dummy pressure for solid region (not solved, required by heSolidThermo)

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    base
    {
        type            calculated;
        value           uniform 101325;
    }

    end
    {
        type            calculated;
        value           uniform 101325;
    }

    symm
    {
        type            symmetryPlane;
    }

    ".*_to_air"
    {
        type            calculated;
        value           uniform 101325;
    }
}

