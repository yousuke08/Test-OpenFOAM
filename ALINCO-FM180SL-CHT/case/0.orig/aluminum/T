FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/aluminum";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293.15;

boundaryField
{
    // Backbone bottom — adiabatic (heat injected via fvOptions led_zone)
    base
    {
        type            zeroGradient;
    }

    // z=0 open end: heat conducts out along Z
    end
    {
        type            zeroGradient;
    }

    // z=0.150 symmetry plane (LED centre)
    symm
    {
        type            symmetryPlane;
    }

    // Coupled interface to air region (name assigned by splitMeshRegions)
    ".*_to_air"
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           uniform 293.15;
    }
}

