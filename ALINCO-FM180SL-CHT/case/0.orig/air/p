FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/air";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    top         { type calculated; value uniform 101325; }
    left_open   { type calculated; value uniform 101325; }
    right_open  { type calculated; value uniform 101325; }
    lower_side  { type calculated; value uniform 101325; }
    bottom      { type calculated; value uniform 101325; }
    end         { type calculated; value uniform 101325; }
    symm        { type symmetryPlane; }

    ".*_to_aluminum" { type calculated; value uniform 101325; }
}

