FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/aluminum";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293.15;

boundaryField
{
    base
    {
        // gradient = Q[W] / (A[m²] * kappa[W/m/K])
        // Updated automatically by scripts/set_heat.py before each run.
        type            fixedGradient;
        gradient        uniform 50.8130;   // placeholder (2.5 W default)
    }

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }

    // Coupled interface to air region (name assigned by splitMeshRegions)
    ".*_to_air"
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           uniform 293.15;
    }
}

