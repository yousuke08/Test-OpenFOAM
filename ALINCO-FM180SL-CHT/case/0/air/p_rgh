FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/air";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    top
    {
        type            fixedValue;
        value           uniform 101325;
    }

    left_open
    {
        type            fixedValue;
        value           uniform 101325;
    }

    right_open
    {
        type            fixedValue;
        value           uniform 101325;
    }

    lower_side
    {
        type            fixedFluxPressure;
        value           uniform 101325;
    }

    bottom
    {
        type            fixedValue;
        value           uniform 101325;
    }

    end
    {
        type            fixedValue;
        value           uniform 101325;
    }

    symm
    {
        type            symmetryPlane;
    }

    ".*_to_aluminum"
    {
        type            fixedFluxPressure;
        value           uniform 101325;
    }
}

