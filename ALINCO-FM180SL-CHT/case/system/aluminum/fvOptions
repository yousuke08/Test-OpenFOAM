FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/aluminum";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// LED heat source: 1.25 W in the half-model (= 2.5 W total for full heatsink)
// Applied to backbone cells in led_zone (x=[-6,6]mm, y=[0,1]mm, z=[140,150]mm)
// Updated by scripts/set_heat.py (value after "h (" on the injectionRateSuSp line)
//

ledHeatSource
{
    type            scalarSemiImplicitSource;
    active          yes;

    scalarSemiImplicitSourceCoeffs
    {
        selectionMode   cellZone;
        cellZone        led_zone;

        volumeMode      absolute;   // total W, not W/m³

        injectionRateSuSp
        {
            h           (1.2500 0);   // HEAT_WATTS/2  [W for half-model]
        }
    }
}

