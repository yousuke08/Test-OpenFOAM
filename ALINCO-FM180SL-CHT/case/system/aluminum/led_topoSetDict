FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/aluminum";
    object      led_topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// LED zone: backbone cells in the last 10 mm of the half-model (z=[0.140,0.150])
// Full backbone width x=[-0.006, 0.006], thickness y=[0, 0.001]
// Corresponds to 20 mm total (both sides of symmetry plane)
//

actions
(
    {
        name    led_zone;
        type    cellSet;
        action  new;
        source  boxToCell;
        sourceInfo
        {
            box (-0.006 0 0.140)(0.006 0.001 0.150);
        }
    }
    {
        name    led_zone;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo { set led_zone; }
    }
);

