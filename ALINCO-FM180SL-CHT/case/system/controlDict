FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// ALINCO FM180SL CHT: E-channel Al heatsink with natural convection.
//   Backbone at bottom (heat source y=0), fins pointing up.
//   Gravity: g = (0 -9.81 0)
//   Heat input: 2.5 W distributed over backbone bottom (12mm x 20mm)
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     chtMultiRegionFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         1800;

deltaT          0.025;

writeControl    runTime;
writeInterval   60;

purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      fixed;
timePrecision   0;

runTimeModifiable true;

// ************************************************************************* //
