FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// ALINCO FM180SL CHT 3-D: LED point source on E-channel heatsink.
//   Half-model: z=[0, 0.150], symmetryPlane at z=0.150 (LED centre).
//   Gravity: g = (0 -9.81 0)
//   Heat input: 2.5 W via fvOptions in backbone LED zone (z=[140,150]mm)
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     chtMultiRegionFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         600;

deltaT          0.025;

writeControl    runTime;
writeInterval   30;

purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      fixed;
timePrecision   0;

runTimeModifiable true;

// ************************************************************************* //
