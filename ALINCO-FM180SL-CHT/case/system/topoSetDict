FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// ALINCO FM180SL: origin at backbone center bottom.
// All coordinates in meters.

actions
(
    // ----------------------------------------------------------------
    // aluminum cellSet: backbone + 3 fins
    // ----------------------------------------------------------------
    {
        name    aluminum;
        type    cellSet;
        action  new;
        source  boxToCell;
        sourceInfo { box (-0.006 0 -1)(0.006 0.001 1); }        // backbone
    }
    {
        name    aluminum;
        type    cellSet;
        action  add;
        source  boxToCell;
        sourceInfo { box (-0.006 0.001 -1)(-0.005 0.008 1); }   // left fin
    }
    {
        name    aluminum;
        type    cellSet;
        action  add;
        source  boxToCell;
        sourceInfo { box (-0.0005 0.001 -1)(0.0005 0.008 1); }  // middle fin
    }
    {
        name    aluminum;
        type    cellSet;
        action  add;
        source  boxToCell;
        sourceInfo { box (0.005 0.001 -1)(0.006 0.008 1); }     // right fin
    }
    {
        name    aluminum;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo { set aluminum; }
    }

    // ----------------------------------------------------------------
    // air cellSet: gaps + above + left/right side columns
    // ----------------------------------------------------------------
    {
        name    air;
        type    cellSet;
        action  new;
        source  boxToCell;
        sourceInfo { box (-0.005 0.001 -1)(-0.0005 0.008 1); }  // left gap
    }
    {
        name    air;
        type    cellSet;
        action  add;
        source  boxToCell;
        sourceInfo { box (0.0005 0.001 -1)(0.005 0.008 1); }    // right gap
    }
    {
        name    air;
        type    cellSet;
        action  add;
        source  boxToCell;
        sourceInfo { box (-0.106 0.008 -1)(0.106 0.108 1); }    // above fins
    }
    {
        name    air;
        type    cellSet;
        action  add;
        source  boxToCell;
        sourceInfo { box (-0.106 0 -1)(-0.006 0.008 1); }       // left side column
    }
    {
        name    air;
        type    cellSet;
        action  add;
        source  boxToCell;
        sourceInfo { box (0.006 0 -1)(0.106 0.008 1); }         // right side column
    }
    {
        name    air;
        type    cellSet;
        action  add;
        source  boxToCell;
        sourceInfo { box (-0.106 -0.050 -1)(-0.006 0 1); }      // lower-left air
    }
    {
        name    air;
        type    cellSet;
        action  add;
        source  boxToCell;
        sourceInfo { box (0.006 -0.050 -1)(0.106 0 1); }        // lower-right air
    }
    {
        name    air;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo { set air; }
    }

);

