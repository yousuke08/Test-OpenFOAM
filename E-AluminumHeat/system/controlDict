FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// Transient heat conduction in E-shaped aluminum.
//
// Diffusion time scale: t ~ L^2 / DT
//   L   = 0.08 m (fin length, longest conduction path)
//   DT  = 8.418e-5 m^2/s
//   t   ~ 0.08^2 / 8.418e-5 ~ 76 s   (to reach steady state)
//
// Run to t=200 s to ensure full steady-state convergence.
//
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     laplacianFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         200;

deltaT          0.5;

writeControl    runTime;
writeInterval   20;

purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

