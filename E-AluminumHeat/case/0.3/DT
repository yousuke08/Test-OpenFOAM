FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0.3";
    object      DT;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];


internalField   uniform 8.418e-05;

boundaryField
{
    base
    {
        type            calculated;
        value           uniform 8.418e-05;
    }
    cooled
    {
        type            calculated;
        value           uniform 8.418e-05;
    }
    front
    {
        type            symmetryPlane;
    }
    back
    {
        type            symmetryPlane;
    }
}


