FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant/air";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
// Air at ~350 K (average of ambient 293 K and fin surface ~400 K):
//   mu  = 2.1e-5 Pa·s
//   Pr  = 0.71
//   Cp  = 1005 J/(kg·K)
//   R   = 287 J/(kg·K)  → molWeight = 8314.5/287 = 28.97
//

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   28.97;
    }
    thermodynamics
    {
        Cp          1005;
        Hf          0;
    }
    transport
    {
        mu          2.1e-05;
        Pr          0.71;
    }
}

